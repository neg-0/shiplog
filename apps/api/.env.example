# ShipLog API Environment Variables

# Database
DATABASE_URL=postgresql://user:password@host:5432/shiplog

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# JWT
JWT_SECRET=

# OpenAI (for generation)
OPENAI_API_KEY=

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Stripe (Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# Optional: Resend for email
RESEND_API_KEY=
DEMO_ACCESS_TOKEN=your-secret-token-here
