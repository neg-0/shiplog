# ShipLog API — copy to apps/api/.env and fill in your local credentials.
# From apps/api: node --env-file=.env --import tsx src/index.ts
# Load values before importing API modules; Prisma CLI also reads .env.

# Local server and browser origins. Use the same browser hostname throughout OAuth.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
# Optional OAuth state-cookie domain; leave empty locally.
# Production uses .shiplog.io. Session cookies remain host-only.
COOKIE_DOMAIN=

# Required: a local PostgreSQL database (replace this illustrative connection).
DATABASE_URL=postgresql://shiplog:shiplog@127.0.0.1:5432/shiplog

# Required for sessions and stored-token encryption. Generate with: openssl rand -hex 32
# Keep this stable for a database: changing it prevents decrypting stored GitHub tokens.
JWT_SECRET=

# Required for GitHub sign-in and repository connection: a development OAuth app.
# Set its callback URL to http://localhost:3001/auth/github/callback.
# Each connected repository gets its own generated webhook secret stored in the DB;
# there is no global GITHUB_WEBHOOK_SECRET setting in the application.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required for draft generation. The model below matches the application's default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required only for billing tests locally. Use Stripe TEST mode with a test database.
# Secret key: sk_test_... (or an appropriately permitted rk_test_... key).
# Webhook signing secret: whsec_... from the test endpoint or Stripe CLI listener.
# Price IDs: price_... for recurring Pro and Team prices in the same test account.
# The webhook endpoint is /billing/webhook on the API.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Optional: email distribution backend (recipient setup is not a self-serve feature).
SENDGRID_API_KEY=

# Optional: send submitted product/changelog feedback to this Discord webhook.
# Release delivery channels are configured per repository in the app, not here.
DISCORD_FEEDBACK_WEBHOOK_URL=

# Optional comma-separated email allowlist for authenticated admin access.
ADMIN_EMAILS=

# Optional comma-separated repository IDs preserving legacy automation/channel access.
# Leave empty for new installations; this does not change Stripe subscriptions.
GRANDFATHERED_REPO_IDS=

# Optional restricted demo/maintenance tools; normal GitHub OAuth does not need these.
# Leaving DEMO_ACCESS_TOKEN empty disables /auth/demo. Treat a configured value as a
# credential: it enables demo sessions and preview generation without GitHub sign-in.
DEMO_ACCESS_TOKEN=
# GitHub token used by demo previews and manual generation scripts.
GITHUB_TOKEN=
