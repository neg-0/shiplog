# ShipLog web — copy to apps/web/.env.local. Next.js loads it automatically.
# API secrets belong in apps/api/.env, never in NEXT_PUBLIC_* variables.

# Server-side API origin for /api/* rewrites and public changelog/preview rendering.
# Keep this an absolute URL. Production uses https://api.shiplog.io.
API_URL=http://127.0.0.1:3001

# Browser-visible API base used by the admin pages. /api uses the same-origin proxy.
# Keep API_URL above configured: server rendering must use an absolute API origin.
NEXT_PUBLIC_API_URL=/api

# Next.js sets NODE_ENV from the dev/build/start command; no override is needed.
