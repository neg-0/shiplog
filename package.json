{
  "name": "shiplog",
  "private": true,
  "homepage": "https://shiplog.io",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "dompurify": "^3.4.13",
      "ws": "^8.21.0",
      "qs": "^6.16.0",
      "form-data": "^4.0.6"
    }
  }
}
